# Public base URL of this service; used to build the expiring media links.
PUBLIC_BASE_URL=https://downloader-host.onrender.com

# Must equal the app's DOWNLOADER_PROVIDER_TOKEN (sent as `Authorization: Bearer`).
PROVIDER_TOKEN=replace-me

# Must equal the app's DOWNLOADER_CALLBACK_SECRET (sent on every callback).
CALLBACK_SECRET=replace-me

# Optional. HMAC key for media links; defaults to CALLBACK_SECRET.
MEDIA_SIGNING_SECRET=

# Optional tuning.
PORT=8080
MEDIA_TTL_SECONDS=300
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=240000
WORK_DIR=/tmp/downloader
